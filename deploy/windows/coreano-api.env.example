# Copy to C:\apps\coreano-api\coreano-api.env on the server (Jenkins passes it as -EnvFile).
# install-coreano-service.ps1 loads every KEY=VALUE line into the NSSM service environment;
# application.properties / application-prod.properties read them as ${KEY}.
# Never commit the real file.

SPRING_PROFILES_ACTIVE=prod

# --- database (required in prod) ---
DB_URL=jdbc:postgresql://localhost:5432/hangeoreum
DB_USERNAME=hangeoreum
DB_PASSWORD=change-me

# --- auth (required in prod) ---
# at least 32 random characters, e.g. PowerShell: [Convert]::ToBase64String((1..48 | % {Get-Random -Max 256}))
JWT_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=30

# --- frontend address (required in prod) ---
FRONT_ORIGIN=https://hangeoreum.example.com
FRONT_URL=https://hangeoreum.example.com

# --- mail (password reset) ---
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@hangeoreum.example.com
SMTP_AUTH=true
SMTP_STARTTLS_ENABLE=true
SMTP_STARTTLS_REQUIRED=true
SMTP_SSL_ENABLE=false

# --- payments (leave empty to keep billing off) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- tuning (optional, defaults shown) ---
# login/register/password-reset attempts per client IP per minute
AUTH_RATE_LIMIT_PER_MINUTE=10
# how often queued events (lesson completion -> XP -> words) are processed, ms
OUTBOX_DELAY_MS=300

# SERVER_PORT and MEDIA_DIR are set by install-coreano-service.ps1 itself.
